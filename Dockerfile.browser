# Browser-fallback image: sourcebolt built with -tags browser on top of headless Chrome.
# Base pinned by tag and digest (stable channel); Dependabot (docker) bumps it.
FROM chromedp/headless-shell:156.0.8078.17@sha256:e45d36d818636b955eb47cc1b40b91068be4aebc3490bcad239c1849f16eff1f
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/sourcebolt /usr/local/bin/sourcebolt
ENV NOTEBOOKLM_CONFIG_DIR=/config
VOLUME ["/config"]
# The base image's entrypoint launches headless-shell; replace it.
ENTRYPOINT ["/usr/local/bin/sourcebolt"]
CMD ["serve"]
